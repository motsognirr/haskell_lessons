    {
      "type": "run",
      "command": "cd lessons/03-recursion-hof && ./hof",
      "expected_output": "[2,4]",
      "description": "myFilter even [1,2,3,4,5] = [2,4]"
    },
    {
      "type": "run",
      "command": "cd lessons/03-recursion-hof && ./hof",
      "expected_output": "15",
      "description": "myFoldl (+) 0 [1,2,3,4,5] = 15"
    },
    {
      "type": "run",
      "command": "cd lessons/03-recursion-hof && ./hof",
      "expected_output": "[2,4,6]",
      "description": "doubleAll or keepEvens works"
    },
    {
      "type": "run",
      "command": "cd lessons/03-recursion-hof && ./hof",
      "expected_output": "14",
      "description": "sumSquares [1,2,3] = 14"
