      "description": "Main.hs exists"
    },
    {
      "type": "file_contains",
      "path": "lessons/03-recursion-hof/Main.hs",
      "pattern": "myMap",
      "description": "Defines myMap function"
    },
    {
      "type": "file_contains",
      "path": "lessons/03-recursion-hof/Main.hs",
      "pattern": "myFilter",
      "description": "Defines myFilter function"
    },
    {
      "type": "file_contains",
      "path": "lessons/03-recursion-hof/Main.hs",
      "pattern": "myFoldl",
      "description": "Defines myFoldl function"
    },
    {
      "type": "compile",
      "command": "cd lessons/03-recursion-hof && ghc -o hof Main.hs",
      "description": "Code compiles successfully"
    },
    {
      "type": "run",
      "command": "cd lessons/03-recursion-hof && ./hof",
      "expected_output": "[2,3,4]",
      "description": "myMap (+1) [1,2,3] = [2,3,4]"
