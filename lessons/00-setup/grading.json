{
  "lesson": 0,
  "checks": [
    {
      "type": "file_exists",
      "path": "lessons/00-setup/Main.hs",
      "description": "Main.hs exists"
    },
    {
      "type": "file_contains",
      "path": "lessons/00-setup/Main.hs",
      "pattern": "import\\s+System\\.Environment",
      "description": "Imports System.Environment"
    },
    {
      "type": "compile",
      "command": "cd lessons/00-setup && ghc -o hello Main.hs",
      "description": "Code compiles successfully"
    },
    {
      "type": "run",
      "command": "cd lessons/00-setup && ./hello",
      "expected_output": "Hello, World! Welcome to Haskell.",
      "description": "No args prints default greeting"
    },
    {
      "type": "run",
      "command": "cd lessons/00-setup && ./hello Alice",
      "expected_output": "Hello, Alice! Welcome to Haskell.",
      "description": "Greets by name when arg provided"
    }
  ]
}
