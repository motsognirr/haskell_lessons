    {
      "type": "run_sequence",
      "steps": [
        { "command": "cd app && rm -f notes.json && cabal run hask -- add \"JSON Test\" --tags \"test,json\" 2>/dev/null", "expected_output": "" },
        { "command": "cd app && cabal run hask -- list 2>/dev/null", "expected_output": "JSON Test" }
      ],
      "description": "Add with tags works"
    },
    {
      "type": "run_sequence",
      "steps": [
        { "command": "cd app && rm -f notes.json && cabal run hask -- add \"Tagged Note\" --tags \"haskell,fp\" 2>/dev/null", "expected_output": "" },
        { "command": "cd app && cabal run hask -- list --tag haskell 2>/dev/null", "expected_output": "Tagged Note" }
      ],
      "description": "List with tag filter works"
    },
    {
      "type": "run",
      "command": "cd app && cat notes.json 2>/dev/null || echo 'no file'",
