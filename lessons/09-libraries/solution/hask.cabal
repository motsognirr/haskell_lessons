cabal-version:  2.4
name:           hask
version:        0.3.0.0
synopsis:       A note-taking CLI app
license:        MIT
build-type:     Simple

executable hask
  main-is:          Main.hs
  other-modules:    Hask.Types
                  , Hask.Storage
                  , Hask.Search
                  , Hask.Error
                  , Hask.CLI
  hs-source-dirs:   src
  build-depends:    base                 >= 4.14 && < 5
                  , aeson                >= 2.0
                  , bytestring           >= 0.10
                  , optparse-applicative >= 0.16
                  , directory            >= 1.3
  default-language: Haskell2010
  ghc-options:      -Wall
