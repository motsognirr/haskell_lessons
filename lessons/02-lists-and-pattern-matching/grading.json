{
  "lesson": 2,
  "checks": [
    {
      "type": "file_exists",
      "path": "lessons/02-lists-and-pattern-matching/Main.hs",
      "description": "Main.hs exists"
    },
    {
      "type": "file_contains",
      "path": "lessons/02-lists-and-pattern-matching/Main.hs",
      "pattern": "myHead",
      "description": "Defines myHead function"
    },
    {
      "type": "file_contains",
      "path": "lessons/02-lists-and-pattern-matching/Main.hs",
      "pattern": "Maybe",
      "description": "Uses Maybe type"
    },
    {
      "type": "compile",
      "command": "cd lessons/02-lists-and-pattern-matching && ghc -o lists Main.hs",
      "description": "Code compiles successfully"
    },
    {
      "type": "run",
      "command": "cd lessons/02-lists-and-pattern-matching && ./lists",
      "expected_output": "Just 1",
      "description": "myHead [1,2,3] returns Just 1"
    },
    {
      "type": "run",
      "command": "cd lessons/02-lists-and-pattern-matching && ./lists",
      "expected_output": "Nothing",
      "description": "myHead [] returns Nothing"
    },
    {
      "type": "run",
      "command": "cd lessons/02-lists-and-pattern-matching && ./lists",
      "expected_output": "Just 3",
      "description": "myLast [1,2,3] returns Just 3"
    },
    {
      "type": "run",
      "command": "cd lessons/02-lists-and-pattern-matching && ./lists",
      "expected_output": "4",
      "description": "countElements counts correctly"
    },
    {
      "type": "run",
      "command": "cd lessons/02-lists-and-pattern-matching && ./lists",
      "expected_output": "FizzBuzz",
      "description": "fizzbuzz produces FizzBuzz for 15"
    }
  ]
}
